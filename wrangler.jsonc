{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lmrouter",
  "main": "src/app.ts",
  "compatibility_date": "2025-08-05",
  "compatibility_flags": ["nodejs_compat"],
  "limits": {
    "cpu_ms": 10000,
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "kv_namespaces": [
    {
      "binding": "LMROUTER_CONFIG_KV",
      "id": "e2dad7cff83d490bb291b529334fa76b",
    },
  ],
  "env": {
    "staging": {
      "name": "lmrouter-staging",
      "kv_namespaces": [
        {
          "binding": "LMROUTER_CONFIG_KV",
          "id": "e2dad7cff83d490bb291b529334fa76b",
        },
      ],
    },
  },
}
